#lang shplait

macro 
| 'do: 
     return $m1 ...':
     'return($m1 ...)'
| 'do: 
    $m1':
    '$m1'
| 'do:
    $x <- return $m1
    $m2
    ...':
    'bind(return($m1), 
          fun($x): 
             do:
               $m2 
               ...)'
| 'do:
    $x <- $m1
    $m2
    ...':
    'bind($m1, 
          fun($x): 
             do:
               $m2 
               ...)'
| 'do: 
    return $m1 ...
    $m2
    ...':
    'do:
      return($m1 ...)
      $m2
      ...'
| 'do: 
    $m1
    $m2
    ...':
    'bind($m1, 
          fun(_): 
             do:
              $m2
              ...)'

fun return(unwrapped :: ?a) :: MaybeErrorOf(?a): 
  Good(unwrapped)

fun bind(wrapped_value :: MaybeErrorOf(?a), unwrap_transform :: (?a -> MaybeErrorOf(?b))) :: MaybeErrorOf(?b): 
  match wrapped_value
  | Good(x): unwrap_transform(x)
  | Error(s): Error(s)

type Value
| intV(n :: Int)
| closV(param::Symbol, body::Exp, env::Env)

def mt_env = []
def extend_env = cons
type Binding
| binding(name:: Symbol, val :: Value)
type Env = Listof(Binding)

fun lookup(s :: Symbol, env :: Listof(Binding)):: MaybeErrorOf(Value):
  match env
  | []: Error("free variable")
  | cons(b, rst):
      cond
      | binding.name(b) == s: return(binding.val(b))
      | ~else: lookup(s, rst)

type Exp
| intE(n :: Int)
| plusE(l:: Exp, r:: Exp)
| multE(l:: Exp, r:: Exp)
| divE(l:: Exp, r:: Exp)
| appE(f:: Exp, arg::Exp)
| funE(param::Symbol, body::Exp)
| idE(s::Symbol)
| letE(n::Symbol, rhs::Exp, body::Exp)
| throwE(msg :: String)
| catchE(try_body :: Exp, catch_body :: Exp, msg :: String)


type MaybeErrorOf(?a)
| Good(value :: ?a)
| Error(message :: String)

fun parse(s :: Syntax) :: Exp:
  cond
  | syntax_is_integer(s):
      intE(syntax_to_integer(s))
  | syntax_is_symbol(s):
      idE(syntax_to_symbol(s))
  | ~else:
      match s
      | 'let $n = $e1: $e2': letE(syntax_to_symbol(n), parse(e1), parse(e2))
      | 'try:
           ~catch $ms:
             $cexp
           $texp': catchE(parse(texp), parse(cexp), syntax_to_string(ms))
      | '$e1 + $e2':
          plusE(parse(e1), parse(e2))
      | '$e1 * $e2':
          multE(parse(e1), parse(e2))
      | '$e1 / $e2':
          divE(parse(e1), parse(e2))
      | 'throw($ms)': throwE(syntax_to_string(ms))
      | '$e1($e2)': appE(parse(e1), parse(e2))
      | 'fun($arg): $body': funE(syntax_to_symbol(arg), parse(body))
      | '($e)': parse(e)
      | ~else: error(#'parse, "invalid input " +& s)

// The main interpreter
fun num_op(e1 :: Exp, e2 :: Exp, env :: Env, op :: (Int, Int) -> Int):: MaybeErrorOf(Value):
  do:
    v_l <- interp(e1, env)
    v_r <- interp(e2, env)
    if v_l is_a intV && v_r is_a intV
    | return(intV(op(intV.n(v_l), intV.n(v_r))))
    | Error("not a number")

fun interp(a :: Exp, env::Env) :: MaybeErrorOf(Value):
  match a
  | throwE(msg): Error(msg)
  | catchE(try_exp, catch_exp, expect_msg):
      match interp(try_exp, env)
      | Good(val): return(val)
      | Error(msg):
          if msg == expect_msg
          | interp(catch_exp, env)
          | Error(msg)
  | intE(n): return(intV(n))
  | idE(s): lookup(s, env)
  | plusE(l, r): num_op(l, r, env, fun(l, r): l + r)
  | multE(l, r): num_op(l, r, env, fun(l, r): l * r)
  | divE(l, r):
      do:
        v_l <- interp(l, env)
        v_r <- interp(r, env)
        if v_l is_a intV && v_r is_a intV
        | if intV.n(v_r) == 0
          | Error("divide by zero")
          | return(intV(intV.n(v_l) / intV.n(v_r)))
        | Error("not a number")
  | appE(f, arg):
      do: 
        v <- interp(f, env)
        match v
        | closV(param, body, c_env):
            do:
              argv <- interp(arg, env)
              interp(body, extend_env(binding(param, argv), c_env))
        | ~else: Error("not a function")
  | letE(n, rhs, body): 
      do:
        v <- interp(rhs, env)
        interp(body, extend_env(binding(n, v), env))
  | funE(param, body): return(closV(param, body, env))

module test:
  check:  interp(intE(3), []) // 3
          ~is Good(intV(3))
  check:  interp(plusE(intE(1), intE(3)), []) // 1 + 3
          ~is Good(intV(4))
  check:  interp(multE(intE(2), intE(4)), []) // 2 * 4
          ~is Good(intV(8))
  check:  interp(divE(intE(6), intE(2)), []) // 4 / 2
          ~is Good(intV(3))
  check:  interp(plusE(intE(1), multE(intE(2), intE(4))), []) // 1 + 2 * 4
          ~is Good(intV(9))
  check:  interp(divE(intE(1), intE(0)), []) // 1 + 2 * 4
          ~is Error("divide by zero")
  check:  interp(plusE(idE(#'id), intE(0)), [])
          ~is Error("free variable")
  check:  interp(parse('let double = (fun (x): x + x) : double(8)'), [])
          ~is Good(intV(16))
  check:  interp(parse('let double = (fun (x): x + x) : let quadruple = (fun (x): double(x) + double(x)) : quadruple(2)'), [])
          ~is Good(intV(8))
  check:  interp(parse('fun (x): x + y'), [])
          ~is Good(closV(#'x, plusE(idE(#'x), idE(#'y)), []))
  check:  interp(parse('(fun (x): fun(y): x + y)(1)'), [])
          ~is Good(closV(#'y, plusE(idE(#'x), idE(#'y)), extend_env(binding(#'x, intV(1)), [])))
  check:  interp(parse('2(2)'), [])
          ~is Error("not a function")
  check:  interp(parse('1 + (fun (x): x)'), [])
          ~is Error("not a number")
  check:  interp(parse(
            'let safe_div = (fun(a): (fun(b): (try:
                                                 ~catch "divide by zero":
                                                   0
                                                 a / b
             ))): safe_div(10)(0)'), [])
          ~is Good(intV(0))
  check:  interp(parse('try:
                          ~catch "user error 2":
                            0
                          throw("user error 1")'), [])
          ~is Error("user error 1")
